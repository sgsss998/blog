---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import ConversionCTA from '../components/ConversionCTA.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Giscus from '../components/Giscus.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	showMeta?: boolean;
	showEngagement?: boolean;
	showArticleCTA?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	keywords = [],
	showMeta = true,
	showEngagement = true,
	showArticleCTA = showEngagement,
} = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			keywords={keywords}
			ogType={showMeta ? 'article' : 'website'}
			publishedTime={showMeta ? pubDate : undefined}
			modifiedTime={showMeta ? updatedDate : undefined}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			/* 微信公众号头条封面 900×383（2.35:1）；object-fit: cover 对齐后台裁切逻辑 */
			.hero-image {
				width: 100%;
				max-width: 900px;
				margin: 0 auto 1rem;
				aspect-ratio: 900 / 383;
				border-radius: 12px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: 100%;
				margin: 0;
				border-radius: 0;
				object-fit: cover;
				object-position: center;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.view-count {
				font-size: 0.9em;
				color: rgb(var(--gray));
				margin-top: 0.5em;
			}
			.comments-section {
				margin-top: 3em;
				padding-top: 2em;
				border-top: 1px solid rgb(var(--gray));
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<img src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<div class="title">
							{showMeta && (
								<div class="date">
									<FormattedDate date={pubDate} />
									{
										updatedDate && (
											<div class="last-updated-on">
												更新于 <FormattedDate date={updatedDate} />
											</div>
										)
									}
								</div>
							)}
							<h1>{title}</h1>
							<hr />
						</div>
						<slot />
						{showArticleCTA && (
							<ConversionCTA
								title="读完这篇，下一步可以拆你的真实流程"
								note="如果你想把类似方法用到自己的资料、工作流或内容系统里，先做一次 AI 落地自测，再带着一个具体流程来聊。"
								remark="文章读者 / AI 自测"
								briefItems={[
									`我读的是：${title}`,
									'我想借鉴到自己的流程是：',
									'我希望先做 AI 自测 / 线上诊断 / Coffee Chat：',
								]}
								primaryHref="/diagnosis"
								primaryLabel="AI 落地自测"
								secondaryHref="/coffee-chat"
								secondaryLabel="上海 Coffee Chat"
							/>
						)}
						{showEngagement && (
							<>
								<div class="view-count">
									<span id="busuanzi_container_page_pv">
										👀 本文阅读量 <span id="busuanzi_value_page_pv"></span> 次
									</span>
								</div>
								<div class="comments-section">
									<Giscus />
								</div>
							</>
						)}
					</div>
			</article>
			</main>
			<Footer />
			{showEngagement && <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>}
		</body>
	</html>
