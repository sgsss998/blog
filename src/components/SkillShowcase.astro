<script>
  document.querySelectorAll('.copy-skill-brief').forEach((button) => {
    button.addEventListener('click', async () => {
      const trigger = button instanceof HTMLElement ? button : null;
      const text = trigger?.dataset.copy ?? '';
      const panel = trigger?.closest('.starter-panel');
      const status = panel?.querySelector('.copy-skill-status');

      try {
        if (!navigator.clipboard || !text) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(text);
        if (status) status.textContent = '已复制，可直接粘贴到微信';
      } catch {
        if (status) status.textContent = '复制失败，请手动复制上面的格式';
      }
    });
  });
</script>

