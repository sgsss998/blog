type SkillItem = {
  code: string;
  title: string;
  summary: string;
  tags: string[];
  scenario: string;
  delivery: string;
  acceptance: string;
  boundary: string;
  proofLevel: string;
  proofLabel: string;
  proofHref: string;
};

type ServiceBundle = {
  title: string;
  summary: string;
  includes: string[];
  bestFor: string;
  proof: string;
};

type ScenarioRoute = {
  signal: string;
  title: string;
  summary: string;
  recommendation: string;
  materials: string[];
  href: string;
  actionLabel: string;
};

type SelectionRow = {
  symptom: string;
  firstModule: string;
  firstMaterials: string;
  acceptance: string;
  nextStep: string;
};

type LocalSkillAsset = {
  lane: string;
  title: string;
  origin: string;
  publicUse: string;
  deliverable: string;
  privacy: string;
  status: string;
};

