---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';

type SocialImage = ImageMetadata | string;
const DEFAULT_SOCIAL_IMAGE = '/images/blog/openclaw-one-stop-cover.jpg';

interface Props {
	title: string;
	description: string;
	image?: SocialImage;
	keywords?: string[];
	author?: string;
	ogType?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = DEFAULT_SOCIAL_IMAGE,
	keywords = [],
	author = '老明',
	ogType = 'website',
	publishedTime,
	modifiedTime,
} = Astro.props;

const siteURL = Astro.site?.toString() ?? 'https://ailaoming.com/';
const imagePath = typeof image === 'string' ? image : image.src;
const imageURL = new URL(imagePath, siteURL);
const graph = [
	{
		'@type': 'WebSite',
		'@id': `${siteURL}#website`,
		url: siteURL,
		name: SITE_TITLE,
		description: 'AI 工作流、知识库、办公 Skills、自动化系统和上海 Coffee Chat。',
		inLanguage: 'zh-CN',
	},
	{
		'@type': 'ProfessionalService',
		'@id': `${siteURL}#ai-service`,
		name: 'AI干货家老明',
		url: siteURL,
		description:
			'面向个人和小团队的 AI 工作流诊断、个人知识库整理、办公 Skills 定制、AI 系统落地陪跑与上海线下 Coffee Chat。',
		areaServed: {
			'@type': 'City',
			name: '上海',
		},
		serviceType: [
			'AI 工作流诊断',
			'个人知识库整理',
			'办公 Skills 定制',
			'AI 系统落地陪跑',
			'上海 AI Coffee Chat',
		],
		sameAs: ['https://github.com/sgsss998'],
	},
];

if (ogType === 'article') {
	graph.push({
		'@type': 'BlogPosting',
		'@id': `${canonicalURL.toString()}#blogposting`,
		mainEntityOfPage: canonicalURL.toString(),
		headline: title,
		description,
		image: imageURL.toString(),
		datePublished: publishedTime?.toISOString(),
		dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
		author: {
			'@type': 'Person',
			name: author,
		},
		inLanguage: 'zh-CN',
	});
}

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': graph,
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0066ff" />
<meta name="color-scheme" content="light" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={author} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

<!-- Google Search Console 验证（如需要可添加） -->
<!-- <meta name="google-site-verification" content="YOUR_VERIFICATION_CODE" />-->

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL.toString()} />
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL.toString()} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL.toString()} />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
