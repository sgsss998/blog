  <script>
    document.querySelectorAll('.copy-signup').forEach((button) => {
      button.addEventListener('click', async () => {
        const trigger = button instanceof HTMLElement ? button : null;
        const text = trigger?.dataset.copy ?? '';
        const panel = trigger?.closest('.brief-panel, .coffee-hero-card');
        const status = panel?.querySelector('.copy-signup-status');

        try {
          if (!navigator.clipboard || !text) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(text);
          if (status) status.textContent = '已复制，可直接粘贴到微信';
        } catch {
          if (status) status.textContent = '复制失败，请手动复制四件套';
        }
      });
    });

    document.querySelectorAll('.copy-topic-signup').forEach((button) => {
      button.addEventListener('click', async () => {
        const trigger = button instanceof HTMLElement ? button : null;
        const text = trigger?.dataset.copy ?? '';
        const panel = trigger?.closest('.topic-signup-card');
        const status = panel?.querySelector('.copy-topic-status');

        try {
