---
import BaseHead from '../components/BaseHead.astro';
import ConversionCTA from '../components/ConversionCTA.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TrustBoundary from '../components/TrustBoundary.astro';
import { WECHAT } from '../consts';

const factorCards = [
  {
    title: '时间成本',
    copy: '每周在重复整理、改稿、查资料、套模板和返工上花多少小时。',
  },
  {
    title: '返工成本',
    copy: '输出不稳定、资料找错、格式乱掉、上下文遗漏带来的二次处理。',
  },
  {
    title: '机会成本',
    copy: '这段时间如果释放出来，能不能转向销售、内容、交付或管理动作。',
  },
  {
    title: '边界成本',
    copy: '隐私、权限、人工确认和验收口径不清，会让 AI 项目看似便宜但后续失控。',
  },
];

const tierCards = [
  {
    label: '低价值 / 不稳定',
    title: '先自学或拿资料卡',
    range: '月度可释放价值偏低，或流程还没有稳定样例。',
    action: '先用资料卡、自测和需求卡把问题压缩清楚。',
    href: '/products',
  },
  {
    label: '方向值得判断',
    title: 'Coffee Chat / 轻量预诊断',
    range: '已有真实卡点，但还不确定是否值得进入项目。',
    action: '带一个脱敏问题先聊，确认下一步是否做诊断。',
    href: '/coffee-chat',
  },
  {
    label: '值得诊断',
    title: 'AI 工作流诊断',
    range: '每月节省价值明显，且有重复流程、资料入口和返工原因。',
    action: '先输出路线图、人机分工、验收口径和暂缓清单。',
    href: '/workflow-diagnosis',
  },
  {
    label: '值得小项目',
    title: 'Skill/SOP 小项目',
    range: '输入、输出和验收稳定，节省价值足以支撑一次交付。',
    action: '用脱敏样例跑通，并沉淀成可复跑 SOP 或 Skill。',
    href: '/skill-sop',
  },
];

const prepChecklist = [
  '这个流程每周或每月确实重复出现，不是一次性灵感。',
  '能提供 1 个脱敏输入样例和 1 个理想输出样例。',
  '能说清哪些内容不公开、不上传、不进入公开展示。',
  '能接受先诊断再报价，不要求一上来做万能系统。',
];

const roiFaqs = [
  {
    question: '这个估算器是在算最终报价吗？',
    answer: '不是。它只帮助你判断一个流程是否值得继续沟通。真实报价仍然取决于资料规模、流程复杂度、隐私边界、验收标准和是否需要后续迭代。',
  },
  {
    question: '为什么要先算时间和返工？',
    answer: 'AI 落地的价值通常不在模型本身，而在减少重复劳动和返工。先量化损耗，才能判断该自学、轻量聊、做诊断，还是进入小项目。',
  },
  {
    question: '估算数据会被上传吗？',
    answer: '不会。所有输入只在你的浏览器里计算；复制按钮只生成一段可粘贴到微信的摘要，不提交、不存储、不上传。',
  },
  {
    question: '如果算出来价值很低怎么办？',
    answer: '那就不急着做项目。先用资料卡、自测或 Coffee Chat 把问题压缩成更稳定的流程，等重复频率和验收口径清楚后再判断。',
  },
];

const roiCopy = [
  `微信：${WECHAT}`,
  '备注：AI ROI 估算',
  '来源：ailaoming.com/roi-calculator',
  '线索类型：AI ROI 估算 / 预算判断',
  '当前流程：',
  '每周耗时：',
  '返工比例：',
  '机会成本口径：',
  '预计 AI 可节省比例：',
  '估算月度节省时间：',
  '估算月度释放价值：',
  '我希望下一步：资料卡 / AI 自测 / Coffee Chat / 工作流诊断 / Skill-SOP 小项目 / 暂不确定',
  '预算意向：自学 / 轻量判断 / 单次诊断 / 单流程小项目 / 阶段陪跑 / 暂不确定',
  '期望启动时间：本周 / 本月 / 先预沟通',
  '是否接受先诊断再项目：是 / 否 / 需要先了解',
  '隐私边界：我会先提供脱敏描述，不直接发送原始敏感材料。',
].join('\n');

const roiStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://ailaoming.com/roi-calculator/#ai-roi-calculator',
  name: 'AI ROI 估算器',
  url: 'https://ailaoming.com/roi-calculator/',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  inLanguage: 'zh-CN',
  description: '用本地浏览器估算重复工作流的时间成本、返工成本、月度可释放价值，并判断适合资料卡、Coffee Chat、工作流诊断或 Skill/SOP 小项目。',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'CNY',
  },
  featureList: [
    '时间成本估算',
    '返工成本估算',
    '月度释放价值估算',
    '合作档位建议',
    '本地浏览器计算',
    '复制 ROI 咨询摘要',
  ],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title="AI ROI 估算器"
      description="本地估算一个重复工作流的时间成本、返工成本和月度可释放价值，判断适合自学、Coffee Chat、AI 工作流诊断还是 Skill/SOP 小项目。"
    />
    <script type="application/ld+json" set:html={JSON.stringify(roiStructuredData)}></script>
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">AI ROI Calculator</p>
          <h1>AI ROI 估算器</h1>
          <p class="tagline">
            先算清一个流程值不值得做 AI。很多 AI 咨询一开始就聊工具，最后会变成泛泛而谈。这里先把每周耗时、返工比例、机会成本和预计节省比例算一遍，用数字判断该自学、Coffee Chat、做诊断，还是进入 Skill/SOP 小项目。
          </p>
          <div class="hero-actions">
            <a class="btn primary" href="#calculator">开始估算</a>
            <a class="btn secondary" href="/diagnosis">先做自测</a>
            <a class="btn secondary" href="/pricing">看合作方式</a>
            <a class="btn secondary" href="/brief">复制需求卡</a>
          </div>
          <p class="hero-note">本地计算，不提交、不存储、不上传；结果只在你点击复制时生成一段微信摘要，不承诺收益。</p>
        </div>
        <aside class="result-panel" aria-label="估算结果">
          <p class="panel-label">当前估算</p>
          <div class="metric-stack">
            <div>
              <span>月度节省时间</span>
              <strong><b id="saved-hours">0</b> 小时</strong>
            </div>
            <div>
              <span>月度释放价值</span>
              <strong>¥<b id="monthly-value">0</b></strong>
            </div>
          </div>
          <div class="tier-box">
            <span id="tier-label">先填写参数</span>
            <h2 id="tier-title">先判断流程是否稳定</h2>
            <p id="tier-copy">估算会根据你的耗时、返工和节省比例实时变化。</p>
          </div>
        </aside>
      </section>

      <section class="section factor-section" aria-label="估算维度">
        <div class="section-head">
          <p class="eyebrow">Before Budget</p>
          <h2>先看四类成本，再谈预算</h2>
          <p>AI 项目不是工具采购，真正要算的是重复工作被释放后，能不能换回更稳定的交付、内容或业务动作。</p>
        </div>
        <div class="factor-grid">
          {factorCards.map((card) => (
            <article>
              <h3>{card.title}</h3>
              <p>{card.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="calculator" class="calculator-panel" aria-label="AI ROI 估算器">
        <div class="calculator-head">
          <div>
            <p class="eyebrow">Local Calculator</p>
            <h2>填写一个重复流程的基本参数</h2>
            <p>估算不是承诺收益，只用于判断是否值得继续沟通。高风险、不可验收或没有样例的需求，即使数字好看也不直接进入项目。</p>
          </div>
          <button type="button" class="copy-roi" data-copy={roiCopy}>复制 ROI 咨询摘要</button>
        </div>

        <div class="input-grid">
          <label>
            <span>每周耗时</span>
            <strong><b id="weekly-hours-value">8</b> 小时</strong>
            <input id="weekly-hours" type="range" min="1" max="40" step="1" value="8" />
          </label>
          <label>
            <span>机会成本口径</span>
            <strong>¥<b id="hourly-value-display">300</b> / 小时</strong>
            <input id="hourly-value" type="range" min="80" max="1500" step="20" value="300" />
          </label>
          <label>
            <span>返工比例</span>
            <strong><b id="rework-rate-value">25</b>%</strong>
            <input id="rework-rate" type="range" min="0" max="80" step="5" value="25" />
          </label>
          <label>
            <span>预计 AI 可节省比例</span>
            <strong><b id="automation-rate-value">35</b>%</strong>
            <input id="automation-rate" type="range" min="10" max="70" step="5" value="35" />
          </label>
        </div>

        <div class="complexity-panel" aria-label="流程复杂度">
          <div>
            <p class="eyebrow">Complexity</p>
            <h3>这个流程现在有多复杂</h3>
          </div>
          <div class="segmented-control" role="group" aria-label="选择流程复杂度">
            <button type="button" data-complexity="simple" data-active="true">单一文档</button>
            <button type="button" data-complexity="workflow">多步骤流程</button>
            <button type="button" data-complexity="system">多工具系统</button>
          </div>
        </div>

        <div class="result-grid" aria-live="polite">
          <article>
            <span>每月原始耗时</span>
            <strong><b id="monthly-hours">0</b> 小时</strong>
            <p>按 4.33 周折算。</p>
          </article>
          <article>
            <span>估算返工耗时</span>
            <strong><b id="rework-hours">0</b> 小时</strong>
            <p>返工不会全部被 AI 消灭，只计入部分可释放空间。</p>
          </article>
          <article>
            <span>年度释放价值</span>
            <strong>¥<b id="yearly-value">0</b></strong>
            <p>用于判断是否值得做诊断或小项目，不代表保证收益。</p>
          </article>
        </div>
        <p id="copy-status" class="copy-status" role="status"></p>
        <div class="manual-copy-panel" aria-label="手动复制 ROI 摘要">
          <p>手动复制摘要</p>
          <pre id="roi-copy-preview">{roiCopy}</pre>
        </div>
      </section>

      <section class="section tier-section" aria-label="估算后的合作路径">
        <div class="section-head">
          <p class="eyebrow">Next Step</p>
          <h2>估算后怎么选下一步</h2>
          <p>不要只看金额。流程稳定、样例清楚、边界明确，才适合继续往服务交付推进。</p>
        </div>
        <div class="tier-grid">
          {tierCards.map((card) => (
            <a href={card.href}>
              <span>{card.label}</span>
              <h3>{card.title}</h3>
              <p>{card.range}</p>
              <strong>{card.action}</strong>
            </a>
          ))}
        </div>
      </section>

      <section class="section prep-panel" aria-label="进入诊断前准备">
        <div>
          <p class="eyebrow">Qualified Lead</p>
          <h2>算出来值得做，也先准备四件事</h2>
          <p>ROI 只是第一层筛选。真正能启动的项目，还要看资料、样例、验收和隐私边界。</p>
        </div>
        <ul>
          {prepChecklist.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <TrustBoundary
        compact={true}
        eyebrow="隐私边界"
        title="估算器只算公开可说的流程成本"
        intro="不要在页面里输入公司名、客户名、账号信息、私人聊天、原始财务材料或未授权内容。第一次沟通只需要脱敏描述和样例口径。"
      />

      <FAQSection title="AI ROI 估算常见问题" items={roiFaqs} />

      <ConversionCTA
        title="把 ROI 结果变成一条可判断的需求"
        note="复制估算摘要后，补一个脱敏样例和当前做法。我会先判断这件事适合自学、Coffee Chat、工作流诊断，还是 Skill/SOP 小项目。"
        remark="AI ROI 估算"
        briefItems={[
          '我想估算的流程是：',
          '估算月度节省时间 / 释放价值是：',
          '我希望下一步：资料卡 / 自测 / Coffee Chat / 工作流诊断 / Skill-SOP 小项目',
        ]}
        primaryHref="/workflow-diagnosis"
        primaryLabel="看工作流诊断"
        secondaryHref="/pricing"
        secondaryLabel="看合作方式"
        briefHref="/brief"
        briefLabel="复制需求卡"
      />
    </main>
    <Footer />

    <script>
      const controls = {
        weeklyHours: document.getElementById('weekly-hours'),
        hourlyValue: document.getElementById('hourly-value'),
        reworkRate: document.getElementById('rework-rate'),
        automationRate: document.getElementById('automation-rate'),
      };

      const displays = {
        weeklyHours: document.getElementById('weekly-hours-value'),
        hourlyValue: document.getElementById('hourly-value-display'),
        reworkRate: document.getElementById('rework-rate-value'),
        automationRate: document.getElementById('automation-rate-value'),
        savedHours: document.getElementById('saved-hours'),
        monthlyValue: document.getElementById('monthly-value'),
        monthlyHours: document.getElementById('monthly-hours'),
        reworkHours: document.getElementById('rework-hours'),
        yearlyValue: document.getElementById('yearly-value'),
        tierLabel: document.getElementById('tier-label'),
        tierTitle: document.getElementById('tier-title'),
        tierCopy: document.getElementById('tier-copy'),
        copyPreview: document.getElementById('roi-copy-preview'),
      };

      const copyButton = document.querySelector('.copy-roi');
      const copyStatus = document.getElementById('copy-status');
      let complexity = 'simple';

      function numberValue(element, fallback) {
        return element instanceof HTMLInputElement ? Number(element.value) : fallback;
      }

      function money(value) {
        return Math.round(value).toLocaleString('zh-CN');
      }

      function fixed(value) {
        return value.toFixed(1).replace(/\.0$/, '');
      }

      function complexityText(value) {
        if (value === 'system') return '多工具系统';
        if (value === 'workflow') return '多步骤流程';
        return '单一文档';
      }

      function recommendation(monthlyValue, savedHours) {
        if (complexity === 'system' && monthlyValue >= 8000) {
          return {
            label: '阶段陪跑候选',
            title: '先做诊断，再判断系统陪跑',
            copy: '多工具系统不适合直接报价。先拆第一个可验收闭环，再决定是否阶段陪跑。',
            next: 'AI 工作流诊断 / 阶段陪跑预审',
          };
        }
        if (monthlyValue >= 5000 && savedHours >= 12) {
          return {
            label: '值得小项目',
            title: '适合评估 Skill/SOP 小项目',
            copy: '节省价值和重复频率都比较明显，可以带脱敏样例判断是否做成可复跑资产。',
            next: 'Skill/SOP 小项目',
          };
        }
        if (monthlyValue >= 1800 || savedHours >= 8) {
          return {
            label: '值得诊断',
            title: '适合先做 AI 工作流诊断',
            copy: '已经有可量化损耗，但还需要先确认资料入口、人机边界和验收标准。',
            next: 'AI 工作流诊断',
          };
        }
        if (monthlyValue >= 600 || savedHours >= 3) {
          return {
            label: '方向值得判断',
            title: '适合 Coffee Chat 或轻量预诊断',
            copy: '先低成本把问题讲清楚，不急着进入正式项目。',
            next: 'Coffee Chat / 轻量预诊断',
          };
        }
        return {
          label: '先自助整理',
          title: '先资料卡、自测或需求卡',
          copy: '当前价值或重复性还不够清晰，先把流程压缩成稳定场景。',
          next: '资料卡 / AI 自测',
        };
      }

      function updateRoi() {
        const weeklyHours = numberValue(controls.weeklyHours, 8);
        const hourlyValue = numberValue(controls.hourlyValue, 300);
        const reworkRate = numberValue(controls.reworkRate, 25);
        const automationRate = numberValue(controls.automationRate, 35);

        const monthlyHours = weeklyHours * 4.33;
        const directSavedHours = monthlyHours * (automationRate / 100);
        const reworkHours = monthlyHours * (reworkRate / 100);
        const reworkSavedHours = reworkHours * 0.45;
        const complexityFactor = complexity === 'system' ? 0.82 : complexity === 'workflow' ? 0.92 : 1;
        const savedHours = Math.max(0, (directSavedHours + reworkSavedHours) * complexityFactor);
        const monthlyValue = savedHours * hourlyValue;
        const yearlyValue = monthlyValue * 12;
        const advice = recommendation(monthlyValue, savedHours);

        if (displays.weeklyHours) displays.weeklyHours.textContent = String(weeklyHours);
        if (displays.hourlyValue) displays.hourlyValue.textContent = String(hourlyValue);
        if (displays.reworkRate) displays.reworkRate.textContent = String(reworkRate);
        if (displays.automationRate) displays.automationRate.textContent = String(automationRate);
        if (displays.savedHours) displays.savedHours.textContent = fixed(savedHours);
        if (displays.monthlyValue) displays.monthlyValue.textContent = money(monthlyValue);
        if (displays.monthlyHours) displays.monthlyHours.textContent = fixed(monthlyHours);
        if (displays.reworkHours) displays.reworkHours.textContent = fixed(reworkHours);
        if (displays.yearlyValue) displays.yearlyValue.textContent = money(yearlyValue);
        if (displays.tierLabel) displays.tierLabel.textContent = advice.label;
        if (displays.tierTitle) displays.tierTitle.textContent = advice.title;
        if (displays.tierCopy) displays.tierCopy.textContent = advice.copy;

        const summary = [
          '微信：soplaoming',
          '备注：AI ROI 估算',
          '来源：ailaoming.com/roi-calculator',
          '线索类型：AI ROI 估算 / 预算判断',
          `每周耗时：${weeklyHours} 小时`,
          `机会成本口径：${hourlyValue} 元/小时`,
          `返工比例：${reworkRate}%`,
          `预计 AI 可节省比例：${automationRate}%`,
          `流程复杂度：${complexityText(complexity)}`,
          `估算月度节省时间：${fixed(savedHours)} 小时`,
          `估算月度释放价值：${money(monthlyValue)} 元`,
          `建议下一步：${advice.next}`,
          '我可以提供的脱敏样例是：',
          '预算意向：自学 / 轻量判断 / 单次诊断 / 单流程小项目 / 阶段陪跑 / 暂不确定',
          '期望启动时间：本周 / 本月 / 先预沟通',
          '是否接受先诊断再项目：是 / 否 / 需要先了解',
          '隐私边界：我会先提供脱敏描述，不直接发送原始敏感材料。',
        ].join('\n');

        if (copyButton instanceof HTMLElement) {
          copyButton.dataset.copy = summary;
        }
        if (displays.copyPreview) displays.copyPreview.textContent = summary;
      }

      Object.values(controls).forEach((control) => {
        control?.addEventListener('input', updateRoi);
      });

      document.querySelectorAll('[data-complexity]').forEach((button) => {
        button.addEventListener('click', () => {
          const trigger = button instanceof HTMLElement ? button : null;
          if (!trigger) return;
          complexity = trigger.dataset.complexity ?? 'simple';
          document.querySelectorAll('[data-complexity]').forEach((item) => {
            if (item instanceof HTMLElement) item.dataset.active = item === trigger ? 'true' : 'false';
          });
          updateRoi();
        });
      });

      copyButton?.addEventListener('click', async () => {
        const text = copyButton instanceof HTMLElement ? copyButton.dataset.copy ?? '' : '';
        try {
          if (!navigator.clipboard || !text) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(text);
          if (copyStatus) copyStatus.textContent = '已复制，可直接粘贴到微信补充脱敏样例';
        } catch {
          if (copyStatus) copyStatus.textContent = '复制失败，请手动复制下方摘要';
        }
      });

      updateRoi();
    </script>
  </body>
</html>

<style>
  main {
    width: 960px;
    max-width: calc(100% - 2rem);
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  .hero,
  .calculator-panel,
