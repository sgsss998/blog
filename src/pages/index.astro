---
import fs from 'node:fs';
import path from 'node:path';
import BaseHead from '../components/BaseHead.astro';
import ConversionCTA from '../components/ConversionCTA.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProofShowcase from '../components/ProofShowcase.astro';
import TrustBoundary from '../components/TrustBoundary.astro';
import { SITE_DESCRIPTION, SITE_TITLE, WECHAT } from '../consts';

const root = process.cwd();
const blogPostCount = fs.readdirSync(path.join(root, 'src/content/blog')).filter((file) => file.endsWith('.md')).length;

const proofMetrics = [
  {
    value: String(blogPostCount),
    label: 'AI 实战文章',
    note: '查看文章库',
    href: '/blog',
  },
  {
    value: '10+',
    label: '可复用 Skills 与 SOP',
    note: '查看 Skill 样例',
    href: '/skills',
  },
  {
    value: '7x24',
    label: '本地 AI 系统长期实测',
    note: '查看项目看板',
    href: '/projects',
  },
  {
    value: '上海',
    label: '线下 Coffee Chat 承接',
    note: '查看活动入口',
    href: '/shanghai-ai',
  },
];

const firstStepRoutes = [
  {
    title: '先自学，不急着咨询',
    signal: '工具很多、方向还散，想先拿一张资料卡压缩问题。',
    action: '领取资料卡',
    href: '/products',
    note: '适合先看 AI 工具路线、Skill 模板或知识库自查。',
  },
  {
    title: '有一个重复流程',
    signal: '已经知道哪件事反复返工，但还说不清输入、输出和验收口径。',
    action: '复制需求卡',
    href: '/brief',
    note: '适合先把需求压缩成可判断、可报价、可验收的描述。',
  },
  {
    title: '想先判断可信度',
    signal: '还没准备需求，想先看公开证据、脱敏样例和验收口径。',
    action: '看公开样例库',
    href: '/cases',
    note: '适合先看我到底怎么拆流程、怎么保护边界。',
  },
  {
    title: '想先算值不值',
    signal: '知道有重复工作在消耗时间，但还没判断是否值得做诊断或小项目。',
    action: '估算 AI ROI',
    href: '/roi-calculator',
    note: '适合先量化每月节省时间、返工成本和预算口径。',
  },
  {
    title: '有内容但不转化',
    signal: '已经有文章、项目、资料包或个人品牌，但访客看完不知道下一步该做什么。',
    action: '看获客站诊断',
    href: '/ai-acquisition',
    note: '适合把文章、样例、自测、需求卡、Coffee Chat 和服务页串成线索路径。',
  },
  {
    title: '在上海想当面拆',
    signal: '问题有现实上下文，适合用一次低噪音交流收束下一步。',
    action: '约 Coffee Chat',
    href: '/coffee-chat',
    note: '适合带一个真实问题来聊工具、资料、内容或业务落地。',
  },
  {
    title: '同主题多人想一起拆',
    signal: '同一主题有 3-8 人，想围绕 AI 工作流、知识库、Skill/SOP 或内容商业化做小班共创。',
    action: '看工作坊预审',
    href: '/workshop',
    note: '适合先判断主题、人数、材料边界和现场可产出的清单。',
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">AI 干货家老明</p>
          <h1>个人 AI 系统落地服务</h1>
          <p class="tagline">
            我把真实工作流里的文档、知识库、自动化和内容生产问题，拆成可复用 SOP、Skills 和可交付系统，帮个人与小团队把 AI 从试用玩具变成稳定干活的生产力。
          </p>
          <div class="hero-actions">
            <a class="btn primary" href="/start">从这里开始</a>
            <a class="btn secondary" href="/cases">查看公开样例</a>
          </div>
          <p class="hero-next">
            不确定第一步，看 <a href="/start">AI 首步分流</a>；有内容但不转化，看 <a href="/ai-acquisition">AI 获客站诊断</a>；在上海想线下聊，看 <a href="/coffee-chat">Coffee Chat</a>。
          </p>
        </div>
        <div class="hero-panel" aria-label="服务摘要">
          <p class="panel-kicker">落地路径</p>
          <div class="route-list">
            <div>
              <span>01</span>
              <strong>诊断流程</strong>
              <p>找到资料源、重复劳动、交付标准和风险边界。</p>
            </div>
            <div>
              <span>02</span>
              <strong>固化 Skill</strong>
              <p>把可重复动作写成 SOP、模板、脚本或工作流。</p>
            </div>
            <div>
              <span>03</span>
              <strong>跑通验收</strong>
              <p>用真实样例核对输出质量、格式、引用和边界。</p>
            </div>
            <div>
              <span>04</span>
              <strong>迭代沉淀</strong>
              <p>把有效流程纳入个人系统、知识库或团队协作。</p>
            </div>
          </div>
        </div>
      </section>

      <section class="proof">
        {proofMetrics.map((item) => (
          <a class="proof-item" href={item.href}>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
            <p>{item.note}</p>
          </a>
        ))}
      </section>

      <section class="section first-step" aria-label="首步分流">
        <div class="section-head">
          <p class="eyebrow">First Step</p>
          <h2>先判断你现在该点哪里</h2>
          <p>
            不用一上来就想清楚要买什么服务。按你现在的状态选第一步，能自助解决就先自助，适合深入再进入诊断、样例或线下交流。
          </p>
        </div>
        <div class="first-step-grid">
          {firstStepRoutes.map((route) => (
            <a class="first-step-card" href={route.href}>
              <h3>{route.title}</h3>
              <p>{route.signal}</p>
              <strong>{route.action}</strong>
              <span>{route.note}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <p class="eyebrow">适合谁</p>
          <h2>不是泛泛聊 AI，而是把一个具体问题落地</h2>
          <a class="text-link" href="/diagnosis">不确定适不适合？先做 3 分钟自测</a>
        </div>
        <div class="fit-grid">
          <article>
            <h3>知识工作者</h3>
            <p>资料散在微信、网盘、Obsidian、飞书和电脑文件夹里，想整理成能被 AI 检索、调用、复用的个人知识系统。</p>
          </article>
          <article>
            <h3>内容创作者</h3>
            <p>需要稳定输出公众号、小红书、课程资料或长文，希望把选题、草稿、配图、同步发布做成半自动流程。</p>
          </article>
          <article>
            <h3>小团队负责人</h3>
            <p>团队反复做会议纪要、报告、报销、资料归档和客户沟通，希望用 AI 降低返工率，而不是只买一堆工具账号。</p>
          </article>
        </div>
      </section>

      <TrustBoundary />

      <section class="section service-band">
        <div class="section-head">
          <p class="eyebrow">服务方向</p>
          <h2>四类可交付服务</h2>
        </div>
        <div class="offer-list">
          <a href="/workflow-diagnosis">
            <span>01</span>
            <strong>AI 工作流诊断</strong>
            <p>梳理目标、工具、资料源和卡点，给出一份可执行路线图。</p>
          </a>
          <a href="/services#knowledge-base">
            <span>02</span>
            <strong>个人知识库整理</strong>
            <p>从文件治理、索引、命名、权重到 AI 检索接入，先让资料可用。</p>
          </a>
          <a href="/skill-sop">
            <span>03</span>
            <strong>办公 Skills 定制</strong>
            <p>把文档、会议、报销、写作、归档等重复任务做成稳定流程。</p>
          </a>
          <a href="/services#automation">
            <span>04</span>
            <strong>AI 系统陪跑</strong>
            <p>围绕 OpenClaw、Codex、RAG 和多 Agent 协作做项目制落地。</p>
          </a>
        </div>
      </section>

      <ProofShowcase />

      <section class="section split">
        <div>
          <p class="eyebrow">线下连接</p>
          <h2>上海 AI Coffee Chat 与小型工作坊</h2>
          <p>
            面向在上海的 AI 工具使用者、知识工作者、创业者和职场转型者。形式是小规模、低噪音、高密度交流：个人问题先 Coffee Chat，同一主题 3-8 人再进入工作坊预审，不讲宏大叙事，直接聊工具、工作流、内容变现和手头的实际问题。
          </p>
          <a class="text-link" href="/shanghai-ai">查看上海本地入口</a>
          <a class="text-link" href="/workshop">查看上海 AI 小型工作坊</a>
        </div>
        <div class="contact-box">
          <p class="contact-title">快速联系</p>
          <p>微信：<strong>{WECHAT}</strong></p>
          <p>备注：AI 咨询 / Coffee Chat / 知识库整理</p>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <p class="eyebrow">证据资产</p>
          <h2>先看文章，再决定要不要聊</h2>
        </div>
        <div class="article-links">
          <a href="/start">AI 首步分流</a>
          <a href="/cases">公开样例库</a>
          <a href="/brief">AI 咨询需求卡</a>
          <a href="/pricing">AI 合作方式与预算口径</a>
          <a href="/roi-calculator">AI ROI 估算器</a>
          <a href="/ai-acquisition">AI 获客站诊断</a>
          <a href="/workflow-diagnosis">AI 工作流诊断服务</a>
          <a href="/skill-sop">Skill/SOP 小项目</a>
          <a href="/delivery">AI 项目交付流程</a>
          <a href="/trust">AI 咨询信任与隐私边界</a>
          <a href="/shanghai-ai">上海 AI 本地服务</a>
          <a href="/workshop">上海 AI 小型工作坊</a>
          <a href="/memory-os">AI 长期记忆库 OS</a>
          <a href="/blog/rag-database-method-open-source/">RAG 记忆系统搭建方法</a>
          <a href="/blog/reimburse-skill-28-versions-open-source/">报销 Skill 的 28 个版本</a>
          <a href="/blog/ai-word-edit-sop-elegant/">Word 文档格式保真 SOP</a>
          <a href="/blog/codex-pro-200-dollar-how-i-use-it/">我如何使用 Codex Pro</a>
        </div>
      </section>

      <ConversionCTA
        title="先用一个具体流程判断能不能落地"
        note="不用先准备完整需求文档。把你现在最想让 AI 接手的一件重复工作发来，我先判断它适合 Coffee Chat、小型工作坊、获客站诊断、轻量诊断，还是做成可复用 Skill/SOP。"
        remark="首页咨询"
        briefItems={[
          '我想让 AI 接手的流程是：',
          '现在的资料、工具或样例在：',
          '我希望先 Coffee Chat / 小型工作坊 / 获客站诊断 / 诊断 / Skill 小项目：',
        ]}
        primaryHref="/start"
        primaryLabel="从这里开始"
        secondaryHref="/services"
        secondaryLabel="看服务方案"
      />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    width: 1080px;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.75fr);
    gap: 2rem;
    align-items: center;
    padding: 4rem 0 3rem;
  }
  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .hero h1 {
    margin: 0;
    font-size: 3rem;
  }
  .tagline {
    max-width: 780px;
    margin: 1rem 0 0;
    color: rgb(var(--gray));
    font-size: 1.1rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.6rem;
  }
  .hero-next {
    margin: 0.85rem 0 0;
    color: rgb(var(--gray));
    font-size: 0.95rem;
  }
  .hero-next a {
    font-weight: 800;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.7rem 1.1rem;
    border: 1px solid rgba(var(--black), 0.12);
    border-radius: 8px;
    font-weight: 700;
  }
  .btn.primary {
    background: var(--accent);
    color: #fff;
  }
  .btn.secondary {
    background: #fff;
    color: rgb(var(--black));
  }
  .hero-panel,
  .contact-box,
  .fit-grid article,
  .first-step-card,
  .offer-list a {
    background: #fff;
    border: 1px solid rgba(var(--black), 0.08);
    border-radius: 8px;
    box-shadow: var(--box-shadow);
  }
  .hero-panel {
    padding: 1.4rem;
  }
  .panel-kicker,
  .contact-title {
    margin: 0 0 0.75rem;
    color: rgb(var(--gray));
    font-size: 0.9rem;
    font-weight: 700;
  }
  .route-list {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }
  .route-list div {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0 0.7rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(var(--black), 0.08);
  }
  .route-list div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .route-list span {
    grid-row: span 2;
    display: inline-flex;
    width: 2.4rem;
    height: 2.4rem;
    align-items: center;
    justify-content: center;
    background: #f3f7ff;
    border: 1px solid rgba(0, 102, 255, 0.16);
    border-radius: 8px;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
  }
  .route-list strong {
    color: rgb(var(--black));
    font-size: 0.95rem;
  }
  .route-list p {
    margin: 0.2rem 0 0;
    color: rgb(var(--gray));
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    padding: 1.2rem 0 2.2rem;
    border-top: 1px solid rgba(var(--black), 0.08);
    border-bottom: 1px solid rgba(var(--black), 0.08);
  }
  .proof-item strong {
    display: block;
    color: rgb(var(--black));
    font-size: 1.45rem;
  }
  .proof-item span {
    display: block;
    color: rgb(var(--gray));
    font-size: 0.9rem;
  }
  .proof-item p {
    margin: 0.45rem 0 0;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 800;
  }
  .proof-item:hover strong,
  .proof-item:hover span {
    color: var(--accent);
  }
  .section {
    margin: 3.4rem 0;
  }
  .section-head {
    max-width: 720px;
    margin-bottom: 1.4rem;
  }
  .section-head p:last-child {
    margin: 0.65rem 0 0;
    color: rgb(var(--gray));
  }
  .section h2 {
    margin: 0;
    font-size: 1.9rem;
  }
  .first-step {
    margin-top: 2.8rem;
  }
  .first-step-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .first-step-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }
  .first-step-card h3 {
    margin: 0 0 0.6rem;
    font-size: 1.02rem;
    line-height: 1.35;
  }
  .first-step-card p {
    flex: 1;
    margin: 0 0 0.85rem;
    color: rgb(var(--gray));
    font-size: 0.92rem;
    line-height: 1.65;
  }
  .first-step-card strong {
    display: inline-flex;
    width: fit-content;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.65rem;
    color: var(--accent);
    font-size: 0.84rem;
    background: #f3f7ff;
    border: 1px solid rgba(0, 102, 255, 0.14);
    border-radius: 8px;
  }
  .first-step-card span {
    margin-top: 0.7rem;
    color: rgb(var(--gray));
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .fit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .fit-grid article {
    padding: 1.2rem;
  }
  .fit-grid h3,
  .offer-list strong {
    margin: 0 0 0.45rem;
    font-size: 1.05rem;
  }
  .fit-grid p,
  .offer-list p,
  .split p,
  .contact-box p {
    margin: 0;
    color: rgb(var(--gray));
  }
  .service-band {
    padding: 2rem;
    background: rgba(var(--gray-light), 0.45);
    border-radius: 8px;
  }
  .offer-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .offer-list a {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem;
    color: inherit;
  }
  .offer-list span {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: 1.5rem;
    align-items: center;
  }
  .contact-box {
    padding: 1.4rem;
  }
  .contact-box strong {
    color: var(--accent);
  }
  .text-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 700;
  }
  .article-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }
  .article-links a {
    padding: 1rem;
    background: #fff;
    border: 1px solid rgba(var(--black), 0.08);
    border-radius: 8px;
    font-weight: 700;
  }
  @media (max-width: 820px) {
    main {
      width: 100%;
    }
    .hero,
    .split,
    .fit-grid,
    .first-step-grid,
    .offer-list,
    .proof,
    .article-links {
      grid-template-columns: 1fr;
    }
    .hero {
      gap: 1.2rem;
      padding: 2.2rem 0 1.5rem;
    }
    .hero h1 {
      font-size: 2rem;
      line-height: 1.18;
    }
    .tagline {
      font-size: 1rem;
    }
    .hero-actions {
      gap: 0.6rem;
    }
    .btn {
      min-height: 44px;
      padding: 0.6rem 0.85rem;
      font-size: 0.95rem;
    }
    .service-band {
      padding: 1.2rem;
    }
  }
</style>
